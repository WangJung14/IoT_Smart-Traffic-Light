@page "/"
@inject ILightControlService LightControlService
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.SignalR.Client
@using SmartTrafficLight.Domain.Enums
@implements IAsyncDisposable

<style>
    /* Premium Dashboard Styles */
    .dashboard-title-container {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    
    .dashboard-title {
        font-family: 'Inter', sans-serif;
        font-weight: 800;
        font-size: 2.5rem;
        background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: 0 0 20px rgba(0, 242, 254, 0.4);
        margin: 0;
    }

    .status-badge {
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.5);
        color: #10b981;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        animation: pulse-badge 2s infinite;
    }

    @@keyframes pulse-badge {
        0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
        70% { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
        100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    /* Card Design */
    .premium-card {
        background: linear-gradient(145deg, rgba(30, 41, 59, 0.6), rgba(15, 23, 42, 0.8));
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-top: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 24px;
        overflow: hidden;
        position: relative;
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
        box-shadow: 0 15px 35px rgba(0,0,0,0.5);
    }
    
    .premium-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.7), 0 0 20px rgba(56, 189, 248, 0.1);
        border-color: rgba(56, 189, 248, 0.3);
    }

    /* Inner components */
    .direction-header {
        background: rgba(0,0,0,0.2);
        padding: 1.5rem 1rem;
        text-align: center;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .direction-title {
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 2px;
        color: #f8fafc;
        text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    }

    /* Waiting Vehicles Display */
    .waiting-display {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: 1.5rem 0;
    }
    .waiting-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: #94a3b8;
        margin-bottom: 0.5rem;
    }
    .waiting-value {
        font-size: 3rem;
        font-weight: 800;
        font-family: 'Courier New', monospace;
        color: #00f2fe;
        line-height: 1;
        text-shadow: 0 0 15px rgba(0, 242, 254, 0.6);
        background: rgba(0,0,0,0.3);
        padding: 0.5rem 2rem;
        border-radius: 12px;
        border: 1px inset rgba(255,255,255,0.1);
    }

    /* Traffic Light Housing */
    .traffic-housing {
        background: linear-gradient(to bottom, #1a1a2e, #0f0f1a);
        padding: 1.5rem;
        border-radius: 40px;
        border: 3px solid #334155;
        box-shadow: 
            inset 0 0 30px rgba(0,0,0,0.9),
            0 10px 20px rgba(0,0,0,0.6),
            0 0 0 2px rgba(255,255,255,0.05);
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin: 0 auto;
        width: fit-content;
    }

    /* Light Lenses */
    .lens {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background-color: #0a0a0a;
        border: 2px solid #000;
        box-shadow: inset 0 5px 10px rgba(0,0,0,0.8), 0 2px 4px rgba(255,255,255,0.1);
        position: relative;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .lens::after {
        content: '';
        position: absolute;
        top: 10%;
        left: 15%;
        width: 30%;
        height: 30%;
        background: linear-gradient(135deg, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0) 100%);
        border-radius: 50%;
    }

    .lens-red.active {
        background: radial-gradient(circle at 30% 30%, #ff6b6b, #e00000);
        box-shadow: 
            0 0 30px 10px rgba(224, 0, 0, 0.6),
            inset 0 0 15px rgba(255,255,255,0.5);
        border-color: #ffb3b3;
    }

    .lens-yellow.active {
        background: radial-gradient(circle at 30% 30%, #ffd93d, #ff9900);
        box-shadow: 
            0 0 30px 10px rgba(255, 153, 0, 0.6),
            inset 0 0 15px rgba(255,255,255,0.5);
        border-color: #ffe680;
    }

    .lens-green.active {
        background: radial-gradient(circle at 30% 30%, #6bff84, #00b31e);
        box-shadow: 
            0 0 30px 10px rgba(0, 179, 30, 0.6),
            inset 0 0 15px rgba(255,255,255,0.5);
        border-color: #b3ffc2;
    }

    /* Timer Screen */
    .timer-screen {
        margin: 2rem auto;
        background: #000;
        border: 2px solid #334155;
        padding: 10px 20px;
        border-radius: 8px;
        font-family: 'Courier New', Courier, monospace;
        font-size: 2.5rem;
        font-weight: 900;
        color: #00f2fe;
        text-shadow: 0 0 10px #00f2fe;
        box-shadow: inset 0 0 15px rgba(0, 242, 254, 0.2);
        min-width: 120px;
        text-align: center;
        position: relative;
    }
    
    .timer-screen::before {
        content: 'T-MINUS';
        position: absolute;
        top: -20px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 0.7rem;
        color: #64748b;
        letter-spacing: 2px;
    }

    /* Control Panel */
    .control-panel {
        background: rgba(0,0,0,0.2);
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        border-top: 1px solid rgba(255,255,255,0.05);
    }

    .override-btn {
        background: transparent;
        border: 1px solid transparent;
        padding: 10px;
        border-radius: 8px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.3s ease;
        color: #fff;
    }

    .btn-red {
        border-color: #ef4444;
        color: #ef4444;
    }
    .btn-red:hover {
        background: #ef4444;
        color: #fff;
        box-shadow: 0 0 15px rgba(239, 68, 68, 0.5);
    }

    .btn-yellow {
        border-color: #eab308;
        color: #eab308;
    }
    .btn-yellow:hover {
        background: #eab308;
        color: #fff;
        box-shadow: 0 0 15px rgba(234, 179, 8, 0.5);
    }

    .btn-green {
        border-color: #22c55e;
        color: #22c55e;
    }
    .btn-green:hover {
        background: #22c55e;
        color: #fff;
        box-shadow: 0 0 15px rgba(34, 197, 94, 0.5);
    }

    /* Logs Table */
    .logs-table {
        background: transparent !important;
    }
    .logs-table th {
        border-bottom: 1px solid rgba(255,255,255,0.1) !important;
        color: #94a3b8 !important;
        font-weight: 600 !important;
    }
    .logs-table td {
        border-bottom: 1px solid rgba(255,255,255,0.05) !important;
        color: #e2e8f0 !important;
    }
    
    .card-padding {
        padding: 1.5rem;
    }
</style>

<div class="dashboard-title-container">
    <h1 class="dashboard-title">NEO TRAFFIC COMMAND</h1>
    <div class="status-badge">SYSTEM ACTIVE</div>
</div>

<MudGrid Spacing="4">
    <!-- Left Column: 4 Traffic Lights -->
    <MudItem xs="12" xl="8">
        <MudGrid Spacing="4">
            @foreach (var dir in new[] { SmartTrafficLight.Domain.Enums.Direction.NORTH, SmartTrafficLight.Domain.Enums.Direction.SOUTH, SmartTrafficLight.Domain.Enums.Direction.EAST, SmartTrafficLight.Domain.Enums.Direction.WEST })
            {
                var state = _states[dir];
                <MudItem xs="12" sm="6" md="6" lg="3">
                    <div class="premium-card h-100 d-flex flex-column">
                        <div class="direction-header">
                            <div class="direction-title">@dir.ToString()</div>
                        </div>

                        <div class="flex-grow-1 d-flex flex-column align-center px-4">
                            
                            <div class="waiting-display">
                                <div class="waiting-label">Vehicles Waiting</div>
                                <div class="waiting-value">@state.VehicleCount.ToString("D2")</div>
                            </div>

                            <div class="traffic-housing">
                                <div class="lens lens-red @(state.CurrentLightState == LightState.RED ? "active" : "")"></div>
                                <div class="lens lens-yellow @(state.CurrentLightState == LightState.YELLOW ? "active" : "")"></div>
                                <div class="lens lens-green @(state.CurrentLightState == LightState.GREEN ? "active" : "")"></div>
                            </div>

                            <div class="timer-screen">
                                @state.CountdownSeconds.ToString("D2")
                            </div>

                        </div>

                        <div class="control-panel">
                            <button class="override-btn btn-red" @onclick="@(() => OverrideLight(dir, LightState.RED))">Force Red</button>
                            <button class="override-btn btn-yellow" @onclick="@(() => OverrideLight(dir, LightState.YELLOW))">Force Yellow</button>
                            <button class="override-btn btn-green" @onclick="@(() => OverrideLight(dir, LightState.GREEN))">Force Green</button>
                        </div>
                    </div>
                </MudItem>
            }
        </MudGrid>
    </MudItem>

    <!-- Right Column: Chart & Logs -->
    <MudItem xs="12" xl="4">
        <div class="d-flex flex-column gap-4 h-100">
            <!-- Chart -->
            <div class="premium-card card-padding">
                <MudText Typo="Typo.h6" Class="font-weight-bold mb-4" Style="color: #f8fafc;">Realtime Traffic Flow</MudText>
                <MudChart ChartType="ChartType.Line" ChartSeries="@_series" XAxisLabels="@_xAxisLabels" Width="100%" Height="300px" ChartOptions="_chartOptions" />
            </div>

            <!-- Logs -->
            <div class="premium-card card-padding flex-grow-1">
                <MudText Typo="Typo.h6" Class="font-weight-bold mb-4" Style="color: #f8fafc;">System Activity Logs</MudText>
                <MudTable Items="@_logs" Dense="true" Hover="true" Elevation="0" Class="logs-table" Style="background: transparent;">
                    <HeaderContent>
                        <MudTh>Time</MudTh>
                        <MudTh>Event</MudTh>
                        <MudTh>Details</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Time">@context.Timestamp.ToString("HH:mm:ss")</MudTd>
                        <MudTd DataLabel="Event">
                            <MudChip T="string" Size="Size.Small" Color="@GetEventColor(context.EventName)" Variant="Variant.Outlined">@context.EventName</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Details">@context.Details</MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            </div>
        </div>
    </MudItem>
</MudGrid>

@code {
    private HubConnection? _hubConnection;
    private System.Threading.Timer? _timer;

    public class IntersectionState
    {
        public SmartTrafficLight.Domain.Enums.Direction Direction { get; set; }
        public int VehicleCount { get; set; }
        public LightState CurrentLightState { get; set; }
        public int CountdownSeconds { get; set; }
    }

    private Dictionary<SmartTrafficLight.Domain.Enums.Direction, IntersectionState> _states = new()
    {
        { SmartTrafficLight.Domain.Enums.Direction.NORTH, new IntersectionState { Direction = SmartTrafficLight.Domain.Enums.Direction.NORTH, CurrentLightState = LightState.RED, CountdownSeconds = 30 } },
        { SmartTrafficLight.Domain.Enums.Direction.SOUTH, new IntersectionState { Direction = SmartTrafficLight.Domain.Enums.Direction.SOUTH, CurrentLightState = LightState.GREEN, CountdownSeconds = 35 } },
        { SmartTrafficLight.Domain.Enums.Direction.EAST, new IntersectionState { Direction = SmartTrafficLight.Domain.Enums.Direction.EAST, CurrentLightState = LightState.RED, CountdownSeconds = 15 } },
        { SmartTrafficLight.Domain.Enums.Direction.WEST, new IntersectionState { Direction = SmartTrafficLight.Domain.Enums.Direction.WEST, CurrentLightState = LightState.RED, CountdownSeconds = 20 } }
    };

    // Chart Data
    private List<ChartSeries<double>> _series = new List<ChartSeries<double>>
    {
        new ChartSeries<double>() { Name = "Vehicles", Data = new double[10] }
    };
    private string[] _xAxisLabels = new string[10];
    private List<double> _trafficData = new List<double>(new double[10]);

    // Table Data
    private List<SystemLog> _logs = new List<SystemLog>();

    // Hardcode ID for demo
    private Guid _demoIntersectionId = Guid.Parse("11111111-1111-1111-1111-111111111111");

    private ChartOptions _chartOptions = new ChartOptions();

    protected override async Task OnInitializedAsync()
    {
        // Initialize X Axis labels
        for (int i = 0; i < 10; i++) _xAxisLabels[i] = "";

        AddLog("System", "Dashboard Initialized. Connecting to SignalR...");

        // Connect to SignalR
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/traffic"))
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<TrafficUpdatePayload>("ReceiveTrafficUpdate", (payload) =>
        {
            if (_states.ContainsKey(payload.Direction))
            {
                _states[payload.Direction].VehicleCount = payload.VehicleCount;
                
                int totalVehicles = _states.Values.Sum(s => s.VehicleCount);
                UpdateChart(totalVehicles);
                
                AddLog("YOLO Update", $"Detected {payload.VehicleCount} vehicles at {payload.Direction}");
                InvokeAsync(StateHasChanged);
            }
        });

        _hubConnection.On<LightStatePayload>("ReceiveLightState", (payload) =>
        {
            if (_states.ContainsKey(payload.Direction))
            {
                var state = _states[payload.Direction];
                state.CurrentLightState = payload.CurrentLightState;
                state.CountdownSeconds = payload.CurrentLightState == LightState.GREEN ? 45 : 30;
                
                AddLog("ML Prediction", $"{payload.Direction} changed to {payload.CurrentLightState}");
                InvokeAsync(StateHasChanged);
            }
        });

        try
        {
            await _hubConnection.StartAsync();
            AddLog("SignalR", "Connected successfully.");
        }
        catch (Exception ex)
        {
            AddLog("SignalR Error", ex.Message);
        }

        // Start countdown timer
        _timer = new System.Threading.Timer(TimerCallback, null, 0, 1000);
    }

    private void TimerCallback(object? stateInfo)
    {
        bool changed = false;
        foreach (var state in _states.Values)
        {
            if (state.CountdownSeconds > 0)
            {
                state.CountdownSeconds--;
                changed = true;
            }
        }
        
        if (changed)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private void UpdateChart(int count)
    {
        _trafficData.RemoveAt(0);
        _trafficData.Add(count);
        _series[0].Data = _trafficData.ToArray();
    }

    private async Task OverrideLight(SmartTrafficLight.Domain.Enums.Direction dir, LightState state)
    {
        AddLog("Manual Override", $"Admin forced {state} on {dir}");
        _states[dir].CurrentLightState = state;
        _states[dir].CountdownSeconds = state == LightState.GREEN ? 45 : 30; // reset on manual override
        
        await LightControlService.ManualOverrideAsync(_demoIntersectionId, dir, state);
        
        StateHasChanged();
    }

    private Color GetEventColor(string eventName)
    {
        return eventName switch
        {
            "System" => Color.Info,
            "SignalR" => Color.Success,
            "SignalR Error" => Color.Error,
            "YOLO Update" => Color.Primary,
            "ML Prediction" => Color.Secondary,
            "Manual Override" => Color.Warning,
            _ => Color.Default
        };
    }

    private void AddLog(string eventName, string details)
    {
        _logs.Insert(0, new SystemLog { Timestamp = DateTime.Now, EventName = eventName, Details = details });
        if (_logs.Count > 50) _logs.RemoveAt(_logs.Count - 1);
    }

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    public class SystemLog
    {
        public DateTime Timestamp { get; set; }
        public string EventName { get; set; } = string.Empty;
        public string Details { get; set; } = string.Empty;
    }
}
