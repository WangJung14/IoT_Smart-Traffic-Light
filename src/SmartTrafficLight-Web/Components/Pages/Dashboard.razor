@page "/"
@inject ILightControlService LightControlService
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable

<MudText Typo="Typo.h4" Class="mb-6 font-weight-bold">Live Dashboard</MudText>

<MudGrid>
    <!-- Left Column: Traffic Light & Stats -->
    <MudItem xs="12" md="4">
        <MudCard Class="glass-card mb-4" Elevation="0">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Intersection #1 (North)</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudIconButton Icon="@Icons.Material.Filled.Traffic" Color="Color.Primary" />
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent Class="d-flex flex-column align-center">
                <!-- Traffic Light Graphic -->
                <div class="d-flex flex-column align-center justify-center p-4 rounded-xl" style="background-color: #0f172a; width: 120px; border: 4px solid #334155;">
                    <div class="rounded-circle mb-2 @GetLightClass(LightState.RED)" style="width: 60px; height: 60px;"></div>
                    <div class="rounded-circle mb-2 @GetLightClass(LightState.YELLOW)" style="width: 60px; height: 60px;"></div>
                    <div class="rounded-circle @GetLightClass(LightState.GREEN)" style="width: 60px; height: 60px;"></div>
                </div>

                <MudText Typo="Typo.h3" Class="mt-6 font-weight-bold" Color="Color.Primary">@_currentVehicleCount</MudText>
                <MudText Typo="Typo.subtitle1" Class="text-muted">Vehicles Waiting</MudText>
            </MudCardContent>
        </MudCard>

        <!-- Manual Override Control Panel -->
        <MudCard Class="glass-card" Elevation="0">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Manual Override</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudButton Variant="Variant.Filled" Color="Color.Error" FullWidth="true" Class="mb-3"
                           OnClick="@(() => OverrideLight(LightState.RED))">
                    Force RED
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Warning" FullWidth="true" Class="mb-3"
                           OnClick="@(() => OverrideLight(LightState.YELLOW))">
                    Force YELLOW
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                           OnClick="@(() => OverrideLight(LightState.GREEN))">
                    Force GREEN
                </MudButton>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Right Column: Chart & Logs -->
    <MudItem xs="12" md="8">
        <MudCard Class="glass-card mb-4" Elevation="0">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Realtime Traffic Flow</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudChart ChartType="ChartType.Line" ChartSeries="@_series" XAxisLabels="@_xAxisLabels" Width="100%" Height="300px" ChartOptions="_chartOptions" />
            </MudCardContent>
        </MudCard>

        <MudCard Class="glass-card" Elevation="0">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">System Activity Logs</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudTable Items="@_logs" Dense="true" Hover="true" Elevation="0" Style="background: transparent;">
                    <HeaderContent>
                        <MudTh>Time</MudTh>
                        <MudTh>Event</MudTh>
                        <MudTh>Details</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Time">@context.Timestamp.ToString("HH:mm:ss")</MudTd>
                        <MudTd DataLabel="Event">@context.EventName</MudTd>
                        <MudTd DataLabel="Details">@context.Details</MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private HubConnection? _hubConnection;
    private int _currentVehicleCount = 0;
    private LightState _currentLightState = LightState.RED;

    // Chart Data
    private List<ChartSeries<double>> _series = new List<ChartSeries<double>>
    {
        new ChartSeries<double>() { Name = "Vehicles", Data = new double[10] }
    };
    private string[] _xAxisLabels = new string[10];
    private List<double> _trafficData = new List<double>(new double[10]);

    // Table Data
    private List<SystemLog> _logs = new List<SystemLog>();

    // Hardcode ID for demo
    private Guid _demoIntersectionId = Guid.Parse("11111111-1111-1111-1111-111111111111");

    private ChartOptions _chartOptions = new ChartOptions();

    protected override async Task OnInitializedAsync()
    {
        // Initialize X Axis labels
        for (int i = 0; i < 10; i++) _xAxisLabels[i] = "";

        AddLog("System", "Dashboard Initialized. Connecting to SignalR...");

        // Connect to SignalR
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/traffic"))
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<TrafficUpdatePayload>("ReceiveTrafficUpdate", (payload) =>
        {
            _currentVehicleCount = payload.VehicleCount;
            UpdateChart(_currentVehicleCount);
            AddLog("YOLO Update", $"Detected {payload.VehicleCount} vehicles at {payload.Direction}");
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<LightStatePayload>("ReceiveLightState", (payload) =>
        {
            _currentLightState = payload.CurrentLightState;
            AddLog("ML Prediction", $"Light changed to {payload.CurrentLightState}");
            InvokeAsync(StateHasChanged);
        });

        try
        {
            await _hubConnection.StartAsync();
            AddLog("SignalR", "Connected successfully.");
        }
        catch (Exception ex)
        {
            AddLog("SignalR Error", ex.Message);
        }
    }

    private void UpdateChart(int count)
    {
        _trafficData.RemoveAt(0);
        _trafficData.Add(count);
        _series[0].Data = _trafficData.ToArray();
    }

    private async Task OverrideLight(LightState state)
    {
        AddLog("Manual Override", $"Admin forced {state}");
        _currentLightState = state;
        
        // Call Domain Service directly!
        await LightControlService.ManualOverrideAsync(_demoIntersectionId, SmartTrafficLight.Domain.Enums.Direction.NORTH, state);
        
        StateHasChanged();
    }

    private string GetLightClass(LightState targetState)
    {
        if (_currentLightState != targetState)
            return "light-off";

        return targetState switch
        {
            LightState.RED => "glow-red",
            LightState.YELLOW => "glow-yellow",
            LightState.GREEN => "glow-green",
            _ => "light-off"
        };
    }

    private void AddLog(string eventName, string details)
    {
        _logs.Insert(0, new SystemLog { Timestamp = DateTime.Now, EventName = eventName, Details = details });
        if (_logs.Count > 50) _logs.RemoveAt(_logs.Count - 1);
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    public class SystemLog
    {
        public DateTime Timestamp { get; set; }
        public string EventName { get; set; } = string.Empty;
        public string Details { get; set; } = string.Empty;
    }
}
